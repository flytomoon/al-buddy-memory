{
  "name": "al-buddy-memory",
  "version": "0.8.0",
  "description": "Portable, governed, model-agnostic memory for AI agents: facts are invalidated rather than overwritten, raw text is the immutable source of truth, erasure on a governed handle runs through policy and is audited, embeddings are a disposable cache, and every fact exports to one documented format.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/governance-server.d.ts",
      "import": "./dist/mcp/governance-server.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/integrations/ai-sdk.d.ts",
      "import": "./dist/integrations/ai-sdk.js"
    },
    "./langchain": {
      "types": "./dist/integrations/langchain.d.ts",
      "import": "./dist/integrations/langchain.js"
    },
    "./mastra": {
      "types": "./dist/integrations/mastra.d.ts",
      "import": "./dist/integrations/mastra.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "bench",
    "bin",
    "dist",
    "docs",
    "!docs/integrations/SUBMISSIONS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:demo",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "release": "node scripts/release.mjs",
    "release:pin": "node scripts/release.mjs --pin",
    "build:demo": "esbuild src/conformance/browser.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=docs/demo/conformance.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.17",
    "@mastra/core": "^1.70.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "ai": "^7.0.114",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "llm",
    "sqlite",
    "provenance",
    "portable",
    "local-first",
    "mcp",
    "mcp-server",
    "agent-memory",
    "long-term-memory",
    "ai-sdk",
    "vercel-ai",
    "langchain",
    "langgraph",
    "mastra"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flytomoon/al-buddy-memory.git"
  },
  "homepage": "https://github.com/flytomoon/al-buddy-memory#readme",
  "bugs": {
    "url": "https://github.com/flytomoon/al-buddy-memory/issues"
  },
  "author": "Chris Canfield",
  "bin": {
    "al-buddy-memory-mcp": "bin/al-buddy-memory-mcp.js",
    "al-buddy-memory": "bin/al-buddy-memory.js"
  },
  "peerDependencies": {
    "ai": ">=7",
    "@langchain/core": ">=1",
    "@langchain/langgraph": ">=1",
    "@mastra/core": ">=1",
    "zod": "^3.25 || ^4"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
