{
  "name": "al-buddy-memory",
  "version": "0.3.5",
  "description": "Portable, governed, model-agnostic memory for AI agents: facts are invalidated never deleted, raw text is the source of truth, embeddings are a disposable cache, and everything exports to one documented format.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/governance-server.d.ts",
      "import": "./dist/mcp/governance-server.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "bench",
    "bin",
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:demo",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "build:demo": "esbuild src/conformance/browser.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=docs/demo/conformance.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "llm",
    "sqlite",
    "provenance",
    "portable",
    "local-first",
    "mcp"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flytomoon/al-buddy-memory.git"
  },
  "homepage": "https://github.com/flytomoon/al-buddy-memory#readme",
  "bugs": {
    "url": "https://github.com/flytomoon/al-buddy-memory/issues"
  },
  "author": "Chris Canfield",
  "bin": {
    "al-buddy-memory-mcp": "bin/al-buddy-memory-mcp.js",
    "al-buddy-memory": "bin/al-buddy-memory.js"
  }
}
