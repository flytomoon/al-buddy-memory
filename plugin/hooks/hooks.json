{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no --package=al-buddy-memory@0.10.0 al-buddy-memory context --hook --max-chars 2000",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
