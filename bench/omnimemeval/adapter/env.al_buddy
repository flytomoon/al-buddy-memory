# ============================================================
# OmniMemEval - al-buddy-memory (local sidecar, one SQLite store per user)
# Usage: ./scripts/run_locomo_eval.sh --lib al_buddy --env .env.al_buddy
#        ./scripts/run_lme_eval.sh --lib al_buddy --env .env.al_buddy --streaming 1
#        ./scripts/run_beam_eval.sh --lib al_buddy --env .env.al_buddy --scale 100k --streaming 1
#        ./scripts/run_pmv2_eval.sh --lib al_buddy --env .env.al_buddy --streaming 1
#        ./scripts/run_halumem_eval.sh --lib al_buddy --env .env.al_buddy --variant medium --streaming 1
#
# Start the sidecar first, from an al-buddy-memory checkout (npm ci && npm run build):
#   node bench/omnimemeval/server.mjs --port 8765 --state-dir <PATH_TO_USER_STORES>
# or let al-buddy-memory's bench/omnimemeval/run.mjs start it, the reader proxy and
# every board for you. No model is called at write; recall runs on this machine.
# ============================================================

# --- al-buddy-memory -----------------------------------------
AL_BUDDY_URL="http://127.0.0.1:8765"                  # REQUIRED - the sidecar
# AL_BUDDY_TIMEOUT=900                                # seconds per call (ingestion embeds on CPU)

# Runner defaults
LLM_WORKERS=10

# Search parameters
TOPK=20

# --- ANSWER (Answer Generation) ------------------------------
ANSWER_MODEL="gpt-4.1-mini-2025-04-14"
ANSWER_BASE_URL="https://api.openai.com/v1"
ANSWER_API_KEY="<YOUR_ANSWER_API_KEY>"

# --- EVAL (LLM-as-Judge Scoring) -----------------------------
EVAL_MODEL="gpt-4o-mini-2024-07-18"
EVAL_BASE_URL="https://api.openai.com/v1"
EVAL_API_KEY="<YOUR_EVAL_API_KEY>"
