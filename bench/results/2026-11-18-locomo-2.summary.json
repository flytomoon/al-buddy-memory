    },
    "recall": "HybridRetriever.recall(the question without the speakers' names, { limit: 100, expand: { now: the date of the conversation's last session }, contentWords: true })",
    "expand": true,
    "query": "bench/locomo/memory.mjs recallQuery: the question with both speakers' names (and any possessive 's) taken out, as asked when two or more words are left; every stored turn begins with its speaker's name, so the name says whose memory to search, not what to search for; the row's recallQuery holds it when it differs",
    "contentWords": true,
    "topK": 40,
    "neighbours": 34,
    "shown": "the first 34 recalled turns, then the turn after and the turn before each of them in its session (best-ranked first), then the rest of what recall returned, until 40 (bench/locomo/memory.mjs showTurns)",
    "supportCheck": "bench/locomo/support.mjs supportCheck, no model call: when the question names one speaker (or a capitalised word of 3+ letters that begins that speaker's name), and the shown turn of the other speaker's own (no \"you\", \"your\" or the named one's name) that shares the most of the question's content words shares at least two and more than any turn said by or to the named one, the context ends with supportNote: \"Note: of the memories above, the ones that share the most words with this question were said by <other>, not by or to <named>. Answer only from what is said by or about <named>; if nothing above says it of <named>, answer that it is not mentioned in the conversation.\"",
    "reading": "c25",
    "context": "\"Memories from the conversation between <speaker a> and <speaker b>, oldest first; each line is one message, led by the date of the session it was said in:\" then one line per shown turn, \"[<session date as the dataset writes it>] <speaker>: <text>[ [shares <photo caption>]]\", sorted by session and turn; when the support check fires, then a blank line and its note",
    "concurrency": 4,
    "recallTiming": "per question, the wall-clock and CPU time of the HybridRetriever.recall call alone, recalls run one at a time with nothing else in this process"
  },
