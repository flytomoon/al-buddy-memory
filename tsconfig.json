{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16", "lib": ["ES2022"],
    "strict": true, "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true, "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "declaration": true, "declarationMap": true, "sourceMap": true, "esModuleInterop": true, "resolveJsonModule": true,
    "outDir": "./dist", "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
